# Copy to /etc/podium-watcher/podium.env on the Pi and chmod 600.
# Everything here is optional; without it the poller simply collects.

# Push, for the moment a discount window opens on a show you starred.
# Pick something unguessable: an ntfy topic is public to anyone who knows it.
PODIUM_NTFY_TOPIC=https://ntfy.sh/podium-CHANGE-ME-to-something-random

# Weekly digest over mail, matching the other watchers in this collection.
PODIUM_SMTP_HOST=
PODIUM_SMTP_PORT=587
PODIUM_SMTP_USER=
PODIUM_SMTP_PASS=
PODIUM_MAIL_TO=
